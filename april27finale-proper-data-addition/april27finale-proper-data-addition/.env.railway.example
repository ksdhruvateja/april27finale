# Required
# Preferred for this project: Neon PostgreSQL URL.
# Use exact uppercase key in Railway Variables.
NEON_DATABASE_URL=

# Optional fallback aliases (not required if NEON_DATABASE_URL is set)
# DATABASE_URL=
# database_url=

# Optional runtime tuning
NODE_ENV=production
LOG_LEVEL=info

# Optional integrations
EASYSHIP_API_KEY=
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
DWOLLA_KEY=
DWOLLA_SECRET=
DWOLLA_ENV=sandbox
CHECKEEPER_TOKEN=
